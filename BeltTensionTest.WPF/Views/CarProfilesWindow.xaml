<Window x:Class="BeltTensionTest.WPF.Views.CarProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car Profiles" Height="420" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False">

    <Border Background="{StaticResource BgBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{StaticResource BgLightBrush}" MouseDown="TitleBar_MouseDown">
                <TextBlock Text="Car Profiles"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,48,0"
                           FontWeight="SemiBold" FontSize="13" Foreground="#D0D0F0"/>
                <Button Width="36" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Click="Close_Click"
                        Background="Transparent" BorderBrush="Transparent" Padding="0" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                            <Path Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" Data="M4,4 L12,12 M12,4 L4,12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txt_Summary" Grid.Row="0" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}"/>

                <ListBox x:Name="lst_Profiles" Grid.Row="1" SelectionMode="Extended" DisplayMemberPath="Display"
                         SelectionChanged="Profiles_SelectionChanged"/>

                <TextBlock x:Name="txt_Status" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#A0A0BE"/>

                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button x:Name="btn_ExportSelected" Content="Export Selected" Width="104" Margin="0,0,8,6" Click="ExportSelected_Click" Style="{DynamicResource BlueButton}"/>
                    <Button x:Name="btn_ExportAll" Content="Export All" Width="84" Margin="0,0,8,6" Click="ExportAll_Click" Style="{DynamicResource BlueButton}"/>
                    <Button x:Name="btn_Import" Content="Import..." Width="84" Margin="0,0,8,6" Click="Import_Click" Style="{DynamicResource GreenButton}"/>
                    <Button x:Name="btn_Delete" Content="Delete" Width="84" Margin="0,0,0,6" Click="Delete_Click" Style="{DynamicResource RedButton}"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
