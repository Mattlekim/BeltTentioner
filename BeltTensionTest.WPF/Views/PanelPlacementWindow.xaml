<Window x:Class="BeltTensionTest.WPF.Views.PanelPlacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Window placement"
        Width="460" Height="400"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource BgLightBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Window placement" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" MouseDown="TitleBar_MouseDown" />
                <Button Grid.Column="1" Width="36" Height="24" Margin="0,0,8,0" Click="Close_Click" Content="X"
                        Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                        Padding="0" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <StackPanel Margin="16">
            <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#FFB02E"/>

            <ComboBox x:Name="cmb_Panel" Margin="0,0,0,12" SelectionChanged="Panel_Changed" DisplayMemberPath="Name"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Distance (m)" VerticalAlignment="Center" Margin="0,0,0,6"
                           ToolTip="Push the window away from you (positive) or toward you (negative). It keeps looking the same size."/>
                <Slider Grid.Row="0" Grid.Column="1" x:Name="sld_Distance" Minimum="-2" Maximum="6" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" Margin="0,0,8,6" ValueChanged="Slider_Changed"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="DistanceValue" VerticalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Text="Turn left / right" VerticalAlignment="Center" Margin="0,0,0,6"
                           ToolTip="Yaw: turn about the window's vertical axis, in degrees"/>
                <Slider Grid.Row="1" Grid.Column="1" x:Name="sld_Yaw" Minimum="-90" Maximum="90" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,8,6" ValueChanged="Slider_Changed"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="YawValue" VerticalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Text="Tilt up / down" VerticalAlignment="Center" Margin="0,0,0,6"
                           ToolTip="Pitch: tip the top of the window toward you (positive) or away, in degrees"/>
                <Slider Grid.Row="2" Grid.Column="1" x:Name="sld_Pitch" Minimum="-90" Maximum="90" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,8,6" ValueChanged="Slider_Changed"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PitchValue" VerticalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Text="Roll" VerticalAlignment="Center" Margin="0,0,0,6"
                           ToolTip="Spin the window about the line from you to it, in degrees"/>
                <Slider Grid.Row="3" Grid.Column="1" x:Name="sld_Roll" Minimum="-180" Maximum="180" TickFrequency="1"
                        IsSnapToTickEnabled="True" Margin="0,0,8,6" ValueChanged="Slider_Changed"/>
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="RollValue" VerticalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="4" Text="3D depth (m)" VerticalAlignment="Center" Margin="0,0,0,6"
                           ToolTip="With 3D on: how far this window's picture stands out of its frame toward you (negative: behind it), added to the overlay window's 3D depth"/>
                <Slider Grid.Row="4" Grid.Column="1" x:Name="sld_Depth" Minimum="-1" Maximum="1" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" Margin="0,0,8,6" ValueChanged="Slider_Changed"/>
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="DepthValue" VerticalAlignment="Center" Margin="0,0,0,6"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Reset this window" Width="130" Height="26" Margin="0,0,8,0" Click="ResetOne_Click"/>
                <Button Content="Reset all" Width="90" Height="26" Click="ResetAll_Click"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
