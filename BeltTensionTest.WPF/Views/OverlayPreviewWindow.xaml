<Window x:Class="BeltTensionTest.WPF.Views.OverlayPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BeltTensionTest.WPF.Views"
        Title="Overlay Preview" Width="980" Height="580"
        Background="#12121E" Foreground="#A0A0BE"
        FontFamily="Segoe UI" WindowStyle="None"
        ResizeMode="CanResize">
    <!-- Not AllowsTransparency: a layered window does not show the native child window the preview draws into. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#12121E" CornerRadius="6" BorderBrush="#FF333344" BorderThickness="1" Padding="0">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource BgLightBrush}">
                <Grid MouseDown="TitleBar_MouseDown">
                    <TextBlock VerticalAlignment="Center" Margin="12,0,40,0" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="Overlay Preview" />
                    <!-- Pretend the sim is in the car, in a practice / qualifying / race session, or watching a replay: only panels that can show in that state appear -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,52,0">
                        <TextBlock Text="Emulate" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="EmulateBox" Width="100" Height="24" SelectedIndex="0" SelectionChanged="EmulateBox_SelectionChanged"
                                  ToolTip="Current follows the sim. The other choices show the overlay as it would look in that state — panels set to show only in the other state are hidden.">
                            <ComboBoxItem Content="Current"/>
                            <ComboBoxItem Content="In car"/>
                            <ComboBoxItem Content="Practice"/>
                            <ComboBoxItem Content="Qualifying"/>
                            <ComboBoxItem Content="Race"/>
                            <ComboBoxItem Content="Replay"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Width="36" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Click="CloseButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="0"
                            BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"
                                      Data="M4,4 L12,12 M12,4 L4,12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- The overlay canvas, letterboxed to the window. Dark backing so
                 the canvas's transparent regions read as empty space. -->
            <Border x:Name="PreviewArea" Margin="10" Background="#0E0E1A" BorderBrush="#46466A" BorderThickness="1">
                <views:PreviewHwndHost x:Name="Surface"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
