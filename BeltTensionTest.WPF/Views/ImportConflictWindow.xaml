<Window x:Class="BeltTensionTest.WPF.Views.ImportConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Profiles" Height="520" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False">

    <Border Background="{StaticResource BgBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{StaticResource BgLightBrush}" MouseDown="TitleBar_MouseDown">
                <TextBlock Text="Import Profiles"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,48,0"
                           FontWeight="SemiBold" FontSize="13" Foreground="#D0D0F0"/>
            </Grid>

            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txt_Header" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="lst_Conflicts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="8" Background="#1E1E30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Replace, Mode=TwoWay}" IsEnabled="{Binding HasDifferences}"
                                                  Content="{Binding Title}" FontWeight="SemiBold" Foreground="#D0D0F0"/>
                                        <TextBlock Text="{Binding Summary}" Margin="22,2,0,4" Foreground="#A0A0BE"/>
                                        <Grid Margin="22,0,0,0" Visibility="{Binding DiffVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Text="Setting" FontWeight="SemiBold" Foreground="#A0A0BE"/>
                                            <TextBlock Grid.Column="1" Text="Current" FontWeight="SemiBold" Foreground="#A0A0BE" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="Imported" FontWeight="SemiBold" Foreground="#FFAA20" HorizontalAlignment="Right"/>
                                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Differences}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="80"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Setting}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Current}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Imported}" Foreground="#FFAA20" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Import" Width="88" Margin="0,0,8,0" Click="Import_Click" IsDefault="True" Style="{DynamicResource GreenButton}"/>
                    <Button Content="Cancel" Width="88" Click="Cancel_Click" IsCancel="True" Style="{DynamicResource BlueButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
