<Window x:Class="BeltTensionTest.WPF.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Update available"
        Width="480" Height="420"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource BgLightBrush}">
            <TextBlock Text="Update available" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="16">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Margin="0,0,0,10" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ActionButton" Content="Download" Width="100" Margin="0,0,8,0"
                        Click="Action_Click" Style="{DynamicResource BlueButton}"/>
                <Button x:Name="LaterButton" Content="Later" Width="80" Click="Later_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="16,16,16,0">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}"/>
            <TextBlock x:Name="SubText" Margin="0,4,0,10"/>
            <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgLightBrush}" Height="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="8"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
