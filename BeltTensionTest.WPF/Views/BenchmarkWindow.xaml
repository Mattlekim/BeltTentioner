<Window x:Class="BeltTensionTest.WPF.Views.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Overlay benchmark"
        Width="720" Height="620" MinWidth="560" MinHeight="420"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource BgLightBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Overlay benchmark" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" MouseDown="TitleBar_MouseDown" />
                <Button Grid.Column="1" Width="36" Height="24" Margin="0,0,8,0" Click="Close_Click" Content="X"
                        Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                        Padding="0" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrightBrush}"/>
            </StackPanel>

            <TextBox Grid.Row="2" x:Name="ReportBox" IsReadOnly="True" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12"
                     Background="#0E0E1A" Foreground="#C8C8E0" BorderBrush="#46466A" BorderThickness="1"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenFolderButton" Content="Open folder" Width="100" Height="26" Margin="0,0,8,0" Visibility="Collapsed" Click="OpenFolder_Click"/>
                <Button x:Name="CopyButton" Content="Copy report" Width="100" Height="26" Margin="0,0,8,0" Visibility="Collapsed" Click="Copy_Click"/>
                <Button x:Name="StartButton" Content="Start (4 minutes)" Width="130" Height="26" Margin="0,0,8,0" Click="Start_Click" Style="{DynamicResource BlueButton}"/>
                <Button x:Name="StopButton" Content="Stop" Width="80" Height="26" Visibility="Collapsed" Click="Stop_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
