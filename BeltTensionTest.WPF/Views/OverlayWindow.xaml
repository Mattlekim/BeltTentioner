<Window x:Class="BeltTensionTest.WPF.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenXR Overlay" Width="560" Height="460"
        Background="Transparent" Foreground="#A0A0BE"
        FontFamily="Segoe UI" WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#12121E" CornerRadius="6" BorderBrush="#FF333344" BorderThickness="1" Padding="0">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource BgLightBrush}">
                <Grid MouseDown="TitleBar_MouseDown">
                    <TextBlock VerticalAlignment="Center" Margin="12,0,40,0" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="OpenXR Overlay"/>
                        <Run x:Name="TitleState" Text="— Disabled" FontWeight="Normal"/>
                    </TextBlock>
                    <Button Width="36" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Click="CloseButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="0"
                            BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2"
                                      Data="M4,4 L12,12 M12,4 L4,12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Log status only -->
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <ToggleButton x:Name="EditButton" DockPanel.Dock="Right" Content="Edit"
                                  Width="60" Height="24" Margin="8,0,0,0"
                                  Checked="EditButton_Changed" Unchecked="EditButton_Changed"/>
                    <ToggleButton x:Name="PreviewButton" DockPanel.Dock="Right" Content="Preview"
                                  Width="70" Height="24" Margin="8,0,0,0"
                                  Checked="PreviewButton_Changed" Unchecked="PreviewButton_Changed"/>
                    <Button x:Name="RecenterButton" DockPanel.Dock="Right" Content="Recenter"
                            Width="70" Height="24" Margin="8,0,0,0" Click="RecenterButton_Click"
                            ToolTip="Center the overlay on where the headset is looking right now"/>
                    <TextBlock x:Name="StatusLabel" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Initialising…"/>
                </DockPanel>

                <!-- One overlay per window, per-window placement and the benchmark -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <CheckBox x:Name="PerWindowCheck" Content="One overlay per window" VerticalAlignment="Center"
                              Margin="0,0,14,0" Foreground="#A0A0BE"
                              Checked="PerWindowCheck_Changed" Unchecked="PerWindowCheck_Changed"
                              ToolTip="Publish every window as its own VR overlay instead of one shared canvas. Uses less GPU memory, and a window that did not change is not copied again. Edit mode, the triple layout and the mouse calibration still use the canvas while they are open."/>
                    <CheckBox x:Name="StereoCheck" Content="3D" VerticalAlignment="Center"
                              Margin="0,0,6,0" Foreground="#A0A0BE"
                              Checked="StereoCheck_Changed" Unchecked="StereoCheck_Changed"
                              ToolTip="Show every window as a pair of overlays, one for each eye, so its picture can stand out of (or sink behind) its frame. Needs One overlay per window; costs about double per window."/>
                    <Slider x:Name="StereoDepthSlider" Width="90" Minimum="-0.5" Maximum="1" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,4,0"
                            ValueChanged="StereoDepthSlider_Changed"
                            ToolTip="How far every window's picture stands out of its frame toward you, in meters (negative: behind it)"/>
                    <TextBlock x:Name="StereoDepthValue" VerticalAlignment="Center" Width="48" Margin="0,0,10,0"/>
                    <Button x:Name="PlacementButton" Content="Window placement..." Width="140" Height="24" Margin="0,0,8,0"
                            Click="PlacementButton_Click"
                            ToolTip="Set each window's distance and rotation (needs One overlay per window)"/>
                    <Button x:Name="BenchmarkButton" Content="Benchmark..." Width="100" Height="24"
                            Click="BenchmarkButton_Click"
                            ToolTip="Measure GPU use and GPU memory for 2 minutes with the single canvas, then 2 minutes with one overlay per window, and compare"/>
                </WrapPanel>

                <!-- Edit-mode panel: VR display size/distance + canvas DPI -->
                <Border Grid.Row="2" x:Name="EditPanel" Visibility="Collapsed"
                        Background="#0E0E1A" BorderBrush="#46466A" BorderThickness="1"
                        CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Width (m)" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="SizeXSlider" Minimum="1" Maximum="8"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,8,4"
                                ValueChanged="DisplaySlider_ValueChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="SizeXValue" VerticalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Height (m)" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="SizeYSlider" Minimum="1" Maximum="8"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,8,4"
                                ValueChanged="DisplaySlider_ValueChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SizeYValue" VerticalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Distance (m)" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="DistanceSlider" Minimum="0.25" Maximum="10"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,8,4"
                                ValueChanged="DisplaySlider_ValueChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DistanceValue" VerticalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="X offset (m)" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <Slider Grid.Row="3" Grid.Column="1" x:Name="OffsetXSlider" Minimum="-5" Maximum="5"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,8,4"
                                ValueChanged="DisplaySlider_ValueChanged"
                                ToolTip="Move the overlay left (negative) or right (positive) of straight ahead"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="OffsetXValue" VerticalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Y offset (m)" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <Slider Grid.Row="4" Grid.Column="1" x:Name="OffsetYSlider" Minimum="-5" Maximum="5"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,8,4"
                                ValueChanged="DisplaySlider_ValueChanged"
                                ToolTip="Move the overlay down (negative) or up (positive) from straight ahead"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" x:Name="OffsetYValue" VerticalAlignment="Center" Margin="0,0,0,4"/>

                        <!-- Canvas resolution = display size × DPI (pixels per meter) -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="DPI (px/m)" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <Slider Grid.Row="5" Grid.Column="1" x:Name="DpiSlider" Minimum="128" Maximum="2048"
                                TickFrequency="16" IsSnapToTickEnabled="True" Margin="0,0,8,4"
                                ValueChanged="DisplaySlider_ValueChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" x:Name="DpiValue" VerticalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Resolution" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ResolutionValue"
                                   VerticalAlignment="Center"/>

                        <!-- Depth-only distance: match the game's UI depth so both eyes agree on the cursor -->
                        <CheckBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DepthOnlyCheck"
                                  Content="Distance changes depth only (keep apparent size)"
                                  Foreground="#A0A0BE" Margin="0,4,0,0"
                                  ToolTip="When ticked, the Distance slider moves the overlay nearer/farther but scales it so it looks exactly the same size, and keeps the resolution and panel layout. Use it to put the overlay at the same depth as the game's UI: slide until the red cursor no longer jumps sideways against the game's cursor when you close one eye, then the other."/>

                        <!-- Line the red edit cursor up with the game's own in-VR mouse cursor -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Mouse" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Calibrate mouse" Height="22" Padding="10,0" Click="CalibrateMouse_Click"
                                    ToolTip="With the game running: put the GAME'S mouse cursor on the green cross shown in VR and left-click, twice. The red cursor then sits on the game's cursor."/>
                            <Button Content="Reset" Height="22" Padding="10,0" Margin="8,0,0,0" Click="ResetMouseCalibration_Click"/>
                        </StackPanel>

                        <!-- Panels can be set to show only in the car, in practice / qualifying / the race, or only in the replay; arrange the layout for one state at a time -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Editing for" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="EditViewBox" Width="110" SelectedIndex="0" SelectionChanged="EditViewBox_SelectionChanged"
                                      ToolTip="Current follows the sim. The other choices show that state's layout (In car covers every session; Practice, Qualifying and Race are single sessions): panels that only appear in other states are hidden, so the two layouts can be arranged separately. Use each panel's Show button to choose when it appears.">
                                <ComboBoxItem Content="Current"/>
                                <ComboBoxItem Content="In car"/>
                                <ComboBoxItem Content="Practice"/>
                                <ComboBoxItem Content="Qualifying"/>
                                <ComboBoxItem Content="Race"/>
                                <ComboBoxItem Content="Replay"/>
                            </ComboBox>
                            <TextBlock Text="Sim now:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <TextBlock x:Name="SimStateValue" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Text="—"/>
                        </StackPanel>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Shape" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="ShapeBox" Width="110" SelectedIndex="0"
                                      SelectionChanged="ShapeBox_SelectionChanged"
                                      ToolTip="Flat is a plain screen. Curved wraps the overlay around you on a cylinder (Width is the arc length), and X offset then slides it around you; it needs a headset runtime with cylinder layers. Triple splits it into three screens like a triple monitor setup (Width is all three laid flat side by side).">
                                <ComboBoxItem Content="Flat"/>
                                <ComboBoxItem Content="Curved"/>
                                <ComboBoxItem Content="Triple"/>
                                <ComboBoxItem Content="Triple + top"/>
                                <ComboBoxItem Content="Triple + bottom"/>
                                <ComboBoxItem Content="Triple + top + bottom"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Curved: how strongly it bends. Only shown for the Curved shape. -->
                        <TextBlock Grid.Row="11" Grid.Column="0" x:Name="CurveLabel" Text="Curve" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CurvePanel" Orientation="Horizontal" Margin="0,6,0,0">
                            <Slider x:Name="CurveSlider" Width="110" Minimum="10" Maximum="150"
                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DisplaySlider_ValueChanged"
                                    ToolTip="How strongly a curved overlay bends. 100% wraps it evenly around you; less is gentler, more is tighter."/>
                            <TextBlock x:Name="CurveValue" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- Triple screens: how wide the middle one is, and how far the outer two turn in -->
                        <TextBlock Grid.Row="12" Grid.Column="0" x:Name="TripleLabel" Text="Triple" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TriplePanel" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="TripleCenterSlider" Width="100" Minimum="20" Maximum="90"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DisplaySlider_ValueChanged"
                                    ToolTip="How much of the width the centre screen takes. The two outer screens share the rest equally."/>
                            <TextBlock x:Name="TripleCenterValue" Width="38" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="Sides turn" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <Slider x:Name="TripleAngleSlider" Width="100" Minimum="0" Maximum="90"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DisplaySlider_ValueChanged"
                                    ToolTip="How far the outer screens turn in toward you, in degrees. 0 keeps all three in one flat line."/>
                            <TextBlock x:Name="TripleAngleValue" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- Triple + top: a fourth screen above the middle one, same width -->
                        <TextBlock Grid.Row="13" Grid.Column="0" x:Name="TopLabel" Text="Top screen" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TopPanel" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="TopHeightSlider" Width="100" Minimum="0.2" Maximum="4"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DisplaySlider_ValueChanged"
                                    ToolTip="How tall the top screen is, in meters. It is as wide as the middle screen."/>
                            <TextBlock x:Name="TopHeightValue" Width="38" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="Tilt forward" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <Slider x:Name="TopAngleSlider" Width="100" Minimum="0" Maximum="90"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DisplaySlider_ValueChanged"
                                    ToolTip="How far the top screen tips forward toward you, in degrees. 0 is upright; 90 faces straight down."/>
                            <TextBlock x:Name="TopAngleValue" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- Triple + bottom: a screen below the middle one, same width -->
                        <TextBlock Grid.Row="14" Grid.Column="0" x:Name="BottomLabel" Text="Bottom screen" VerticalAlignment="Center" Margin="0,6,10,0"/>
                        <StackPanel Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BottomPanel" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="BottomHeightSlider" Width="100" Minimum="0.2" Maximum="4"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DisplaySlider_ValueChanged"
                                    ToolTip="How tall the bottom screen is, in meters. It is as wide as the middle screen."/>
                            <TextBlock x:Name="BottomHeightValue" Width="38" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="Tilt back" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <Slider x:Name="BottomAngleSlider" Width="100" Minimum="0" Maximum="90"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DisplaySlider_ValueChanged"
                                    ToolTip="How far the bottom screen tips toward you, in degrees. 0 is upright; 90 faces straight up."/>
                            <TextBlock x:Name="BottomAngleValue" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Background="#0E0E1A" Foreground="#A0A0BE" BorderBrush="#46466A" BorderThickness="1"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
